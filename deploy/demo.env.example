# Copy to .env.demo in the repository root; never commit the filled file.
# Optional: real, paid DeepSeek generation over built-in sample content.
# Leave empty for the local scripted experience with no external API calls.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Optional stable signing secret for browser roundtable checkpoints.
# Use a long random value for a dedicated deployment; never commit its real value.
# Empty: derive from DEEPSEEK_API_KEY. Without either, recovery is process-local only.
WENSHAN_DEMO_SESSION_SECRET=
# Shared across all visitors, counted per upstream attempt, resets at 00:00 UTC.
# Positive integer; failed requests also consume a reservation.
# Requires persistent SQLite; ephemeral cloud instances reset this counter.
WENSHAN_DEMO_DAILY_AI_LIMIT=200
