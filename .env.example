# demo: no external requests; live: real Zhihu API (requires an Access Secret).
WENSHAN_PROVIDER=demo
ZHIHU_ACCESS_SECRET=
ZHIHU_ANSWER_MODEL=zhida-thinking-1p5
ZHIHU_TIMEOUT_MS=120000
# auto: Zhida completion; sources: return retrieved excerpts without calling Zhida.
ZHIHU_GENERATION_MODE=auto
# Single Node.js instance with persistent storage. Never use ephemeral disk in production.
WENSHAN_DB_PATH=.data/wenshan-agent-v2.sqlite
