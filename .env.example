# 1: full-site sample content; never call Zhihu or OAuth upstreams.
# With DEEPSEEK_API_KEY, retain paid AI generation; without it, use local scripts.
# 0: standard behavior below. Restart the server after changing this setting.
WENSHAN_PUBLIC_DEMO=0
# Public demo only: shared daily DeepSeek request budget; resets at 00:00 UTC.
# Must be a positive integer. Failed upstream attempts also count; stored in SQLite.
WENSHAN_DEMO_DAILY_AI_LIMIT=200
# Standard mode only: demo skips Q&A retrieval/generation; live uses real Zhihu API.
# WENSHAN_PROVIDER=demo alone does not switch reading, roundtable, or OAuth to samples.
WENSHAN_PROVIDER=demo
# auto: use DeepSeek when a key is present, otherwise the Zhihu assistant model; local demo rules only without any credential.
# local: never call a model; deepseek: require the key.
WENSHAN_CLARIFICATION_MODE=auto
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# auto: semantic query planning and review when a DeepSeek key (or Zhihu Access Secret) is available.
# basic: original keyword search; deepseek: attempt optimization, explicitly report fallback on failure.
WENSHAN_SEARCH_MODE=auto
ZHIHU_ACCESS_SECRET=
ZHIHU_ANSWER_MODEL=zhida-thinking-1p5
ZHIHU_TIMEOUT_MS=120000
# auto: Zhida completion; sources: return retrieved excerpts without calling Zhida.
ZHIHU_GENERATION_MODE=auto
# Roundtable model (defaults to ZHIHU_ANSWER_MODEL). zhida-fast-1p5 is ~5x faster; when it
# answers in prose instead of JSON the fallback model gets one attempt for that call.
ZHIHU_ROUNDTABLE_MODEL=zhida-fast-1p5
ZHIHU_ROUNDTABLE_FALLBACK_MODEL=zhida-thinking-1p5
# Single Node.js instance with persistent storage. Never use ephemeral disk in production.
WENSHAN_DB_PATH=.data/wenshan-agent-v2.sqlite
# Dev only: extra hosts allowed to load /_next dev resources, e.g. your LAN IP for phone testing.
WENSHAN_DEV_ORIGINS=
# Zhihu OAuth (hackathon): app_id/app_key 来自活动页面项目详情；redirect_uri 必须与登记值完全一致（公网 HTTPS）。
ZHIHU_OAUTH_APP_ID=
ZHIHU_OAUTH_APP_KEY=
ZHIHU_OAUTH_REDIRECT_URI=
